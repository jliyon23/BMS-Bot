# Core
BMS_ENV=dev
BMS_DEBUG=false
# Absolute paths are recommended. Relative paths resolve against the project root.
BMS_DATA_DIR=./data
BMS_DATABASE_URL=sqlite+aiosqlite:///./data/bmsbot.db

# Docker host user (keeps ./data writable by the same local user)
BMS_UID=1000
BMS_GID=1000

# Telegram (leave empty to run workers/admin without the bot)
BMS_TELEGRAM_BOT_TOKEN=
BMS_TELEGRAM_WEBHOOK_SECRET=

# Admin dashboard
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
BMS_ADMIN_SECRET_KEY=change-this-to-a-long-random-value
BMS_ADMIN_SESSION_TTL_SEC=1800

# Direct mode is allowed in dev. In production set BMS_ENV=prod; direct mode is
# then blocked unless BMS_ALLOW_DIRECT=true.
BMS_ALLOW_DIRECT=false

# Proxy hunter
BMS_PROXY_COUNTRY=IN
BMS_PROXY_FREE_ENABLED=true
BMS_PROXY_VALIDATION_ITERATIONS=5
# Static proxies need 4/5. Rotating proxies are accepted at 2/5 because the
# client retries and each retry may use a healthy exit IP.
BMS_PROXY_VALIDATION_REQUIRED=4
BMS_PROXY_VALIDATION_REQUIRED_ROTATING=2
BMS_PROXY_MAX_P95_MS=8000
BMS_PROXY_MAX_P95_MS_ROTATING=15000
BMS_PROXY_REFRESH_SEC=900
BMS_PROXY_RECHECK_SEC=600
BMS_PROXY_CANDIDATE_LIMIT=150
BMS_PROXY_VALIDATION_BATCH=15
BMS_PROXY_VALIDATION_CONCURRENCY=4

# Rotating proxy retry/failure policy
BMS_ROTATING_RETRIES=3
BMS_ROTATING_FAILURE_THRESHOLD=3
BMS_ROTATING_COOLDOWN_SEC=60

# Scraper cadence
BMS_POLL_INTERVAL_SEC=10
BMS_SEAT_POLL_INTERVAL_SEC=30
BMS_MAX_CONCURRENT_SCRAPES=4
BMS_MAX_REQUESTS_PER_SEC=2
BMS_MAX_SEAT_CHECKS_PER_SCAN=10
BMS_SEAT_ALERT_THRESHOLD=5
BMS_SEAT_ALERT_COOLDOWN_SEC=60
BMS_WORKER_ID=monitor-1

# Fernet key used to encrypt premium proxy credentials at rest.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
BMS_PROXY_ENCRYPTION_KEY=
